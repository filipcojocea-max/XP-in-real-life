fy({\n        date\n      })\n    }),\n    uncompleteTask: (id, date) => req(`/tasks/${id}/uncomplete`, {\n      method: 'POST',\n      body: JSON.stringify({\n        date\n      })\n    }),\n    listGoals: () => req('/goals'),\n    goalsXpCaps: () => req('/goals/xp-caps'),\n    createGoal: body => req('/goals', {\n      method: 'POST',\n      body: JSON.stringify(body)\n    }),\n    updateGoalProgress: (id, current_value) => req(`/goals/${id}/progress`, {\n      method: 'POST',\n      body: JSON.stringify({\n        current_value\n      })\n    }),\n    updateGoal: (id, body) => req(`/goals/${id}`, {\n      method: 'PUT',\n      body: JSON.stringify(body)\n    }),\n    restartGoal: id => req(`/goals/${id}/restart`, {\n      method: 'POST'\n    }),\n    deleteGoal: id => req(`/goals/${id}`, {\n      method: 'DELETE'\n    }),\n    achievements: () => req('/achievements'),\n    statsDaily: date => req(`/stats/daily${date ? `?date=${date}` : ''}`),\n    statsWeekly: () => req('/stats/weekly'),\n    statsMonthly: () => req('/stats/monthly'),\n    statsByArea: () => req('/stats/by-area'),\n    // ──────── Library+ Mini-App Ratings ────────\n    // Returns aggregate stats for all 4 featured mini-apps + the\n    // caller's own rating per app (null if never rated).\n    libraryRatings: () => req('/library/ratings'),\n    // Upserts the caller's rating (1–5) for a single mini-app and\n    // returns the freshly recomputed aggregate so the UI can update\n    // without a full refetch.\n    rateMiniApp: (app_id, stars) => req('/library/ratings', {\n      method: 'POST',\n      body: JSON.stringify({\n        app_id,\n        stars\n      })\n    }),\n    // ──────── Library+ Mini-App Pricing & Purchases ────────\n    // Returns price/currency/discount info for all 4 mini-apps + a\n    // per-user `purchased` flag for each. Free apps (price=0) ALWAYS\n    // surface as `is_free:true`; the app card renders a green FREE pill\n    // for them and a price tag (with optional strik