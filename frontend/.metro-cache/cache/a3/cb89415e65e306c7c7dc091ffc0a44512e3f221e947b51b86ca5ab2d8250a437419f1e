dius_m, label) => req('/bt/settings', {\n      method: 'POST',\n      body: JSON.stringify({\n        lat,\n        lng,\n        radius_m,\n        label\n      })\n    }),\n    btGroupToggle: (gid, enabled) => req(`/bt/groups/${gid}/toggle`, {\n      method: 'POST',\n      body: JSON.stringify({\n        enabled\n      })\n    }),\n    btGroupPrefs: () => req('/bt/groups/prefs'),\n    // ── Awake-hours schedule ──────────────────────────────────────────\n    // 2026-06-02 — the BT awake window is now SYNCED with the\n    // Work-Scheduler mini-app (profile.shift_schedule). No manual entry\n    // here. The legacy POST endpoint was removed; only GET remains so\n    // the UI can render the \"Active right now\" status pill.\n    btGetSchedule: () => req('/bt/schedule'),\n    // Solo hunt loop\n    btSoloStart: (lat, lng, radius_m) => req('/bt/solo/start', {\n      method: 'POST',\n      body: JSON.stringify({\n        lat,\n        lng,\n        radius_m\n      })\n    }),\n    btSoloCurrent: () => req('/bt/solo/current'),\n    btSoloCompass: (lat, lng) => req(`/bt/solo/compass?lat=${lat}&lng=${lng}`),\n    btSoloFind: (lat, lng, photo_base64) => req('/bt/solo/find', {\n      method: 'POST',\n      body: JSON.stringify({\n        lat,\n        lng,\n        photo_base64\n      })\n    }),\n    btSoloFinds: () => req('/bt/solo/finds'),\n    // Friends — groups\n    btGroupCreate: (name, lat, lng, radius_m) => req('/bt/groups/create', {\n      method: 'POST',\n      body: JSON.stringify({\n        name,\n        lat,\n        lng,\n        radius_m\n      })\n    }),\n    btGroupInvite: (gid, friend_ids) => req(`/bt/groups/${gid}/invite`, {\n      method: 'POST',\n      body: JSON.stringify({\n        friend_ids\n      })\n    }),\n    /**\n     * Full friend list + per-friend eligibility metadata for the BT\n     * invite UI. reason values:\n     *   'no_app'           — friend hasn't opened/installed BT yet\n     *   'different_region' — has BT but area doesn't overlap mine\n     *   'no_my_area'       — I haven't set my own area yet\n     *    null              — eligible (selectable)\n     */\n    btFriendsEligible: () => req('/bt/friends-eligible'),\n    /** Persistent invites — list every pending one with requires_view=true.\n     *  Per Round B spec these notifications stay until the player explicitly\n     *  views them by opening the group page (which calls btInviteView). */\n    btInvitesPending: () => req('/bt/invites/pending'),\n    btInviteView: gid => req(`/bt/invites/${gid}/view`, {\n      method: 'POST'\n    }),\n    // ── Issue Reporting (2026-06-04) ─────────────────────────────────\n    /** Quick rate-limit probe — true iff the user can file a fresh\n     *  report for the current hunt (no pending one already exists). */\n    btReportsCanReport: params => {\n      const qs = new URLSearchParams();\n      if (params.hunt_id) qs.set('hunt_id', params.hunt_id);\n      if (params.group_id) qs.set('group_id', params.group_id);\n      return req(`/bt/reports/can-report?${qs.toString()}`);\n    },\n    /** Submit a new report. Category is exactly 'chest' or 'location'.\n     *  Coordinates are pulled server-side from the active hunt — the\n     *  client never sends them. */\n    btReportsCreate: body => req('/bt/reports', {\n      method: 'POST',\n      body: JSON.stringify(body)\n    }),\n    /** Pending reports awaiting THIS user's review (creator or admin). */\n    btReportsPending: () => req('/bt/reports/pending'),\n    /** Open a single report (also marks it viewed for the caller). */\n    btReportsGet: rid => req(`/bt/reports/${rid}`),\n    btReportsConfirm: rid => req(`/bt/reports/${rid}/confirm`, {\n      method: 'POST'\n    }),\n    btReportsIgnore: rid => req(`/bt/reports/${rid}/ignore`, {\n      method: 'POST'\n    }),\n    // ── Play-with-Friends Rotation (2026-06-04) ──────────────────────\n    /** Finder buries a fresh chest in a new public spot. Server validates\n     *  caller is the current holder +