(`/messages/${message_id}/react`, {\n      method: 'POST',\n      body: JSON.stringify({\n        emoji\n      })\n    }),\n    messagesRead: friend_id => req('/messages/read', {\n      method: 'POST',\n      body: JSON.stringify({\n        friend_id\n      })\n    }),\n    messagesUnreadSummary: () => req('/messages/unread-summary'),\n    pushRegisterToken: (token, platform) => req('/push/register-token', {\n      method: 'POST',\n      body: JSON.stringify({\n        token,\n        platform\n      })\n    }),\n    // ─── Per-friend chat preferences (colors + mute + soft-block) ─────\n    chatPrefsBulk: () => req('/chat/preferences'),\n    chatPrefsGet: friendId => req(`/chat/preferences/${friendId}`),\n    chatPrefsUpsert: (friendId, patch) => req(`/chat/preferences/${friendId}`, {\n      method: 'POST',\n      body: JSON.stringify(patch)\n    }),\n    chatPrefsMute: (friendId, value) => req(`/chat/preferences/${friendId}/mute`, {\n      method: 'POST',\n      body: JSON.stringify({\n        value\n      })\n    }),\n    chatPrefsBlock: (friendId, value) => req(`/chat/preferences/${friendId}/block`, {\n      method: 'POST',\n      body: JSON.stringify({\n        value\n      })\n    }),\n    // ─── Duo Referral Discounts (Library+) ─────────────────────────\n    libraryDuoOfferSet: (appId, requiredPeople, discountedPrice, currency = 'USD') => req(`/library/pricing/${appId}/duo-discount`, {\n      method: 'POST',\n      body: JSON.stringify({\n        required_people: requiredPeople,\n        discounted_price: discountedPrice,\n        currency\n      })\n    }),\n    libraryDuoOfferClear: appId => req(`/library/pricing/${appId}/duo-discount`, {\n      method: 'DELETE'\n    }),\n    libraryDuoOfferGet: appId => req(`/library/duo-offer/${appId}`),\n    duoCreate: appId => req('/duo/create', {\n      method: 'POST',\n      body: JSON.stringify({\n        app_id: appId\n      })\n    }),\n    duoJoin: codeOrGroupId => req('/duo/join', {\n      method: 'POST',\n      